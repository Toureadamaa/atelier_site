{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lancer le site (runserver)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "runserver"
      ],
      "django": true,
      "justMyCode": true
    },
    {
      "name": "Lancer les tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "test",
        "atelier"
      ],
      "django": true,
      "env": {
        "DB_ENGINE": "sqlite"
      }
    }
  ]
}
